# ACE Enterprise Configuration

# Environment
ENV=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://ace_user:ace_password@localhost:5432/ace_enterprise
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers
# Ollama (Local - Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3-coder:30b

# OpenAI (Optional - leave empty if not using)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview

# Anthropic (Optional - leave empty if not using)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20240620

# DeepSeek API (Optional - leave empty if not using)
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Default LLM Provider (ollama, openai, anthropic, deepseek)
DEFAULT_LLM_PROVIDER=ollama

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ACE Core Configuration
# Retrieval
RETRIEVAL_TOP_K=20
RETRIEVAL_SIMILARITY_THRESHOLD=0.7
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85

# Reflection
MAX_REFINEMENT_ROUNDS=3
ENABLE_ITERATIVE_REFLECTION=true

# Curation
TOKEN_BUDGET_PER_SECTION=10000
ENABLE_REDUNDANCY_CHECKING=true

# Performance & Reliability
CHECKPOINT_FREQUENCY=50
REGRESSION_THRESHOLD=0.05
ENABLE_AUTO_ROLLBACK=true
REGRESSION_WINDOW_RECENT=20
REGRESSION_WINDOW_BASELINE=50

# Adaptation Mode (offline, online, hybrid)
ADAPTATION_MODE=hybrid
MAX_EPOCHS=5
BATCH_SIZE=1

# Monitoring
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage & Retention
EXPERIMENT_LOG_RETENTION_DAYS=365
CHECKPOINT_RETENTION_COUNT=50
ENABLE_LOG_COMPRESSION=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=10
